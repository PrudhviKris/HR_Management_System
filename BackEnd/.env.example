# ---- Application
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Asia/Kolkata

# ---- Database (MySQL). Create the DB first:
#   CREATE DATABASE hrms_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# URL-encode special characters in the password (e.g. @ -> %40).
# Leave unset to fall back to a local SQLite file (BackEnd/hrms_dev.db).
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/hrms_db?charset=utf8mb4

# ---- Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ---- Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Email (optional). Without SMTP_HOST emails are rendered and stored in email_logs only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=HRMS <no-reply@example.com>
